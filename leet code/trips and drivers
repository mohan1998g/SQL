with full_data as ( select  t.trip_id, t.driver_id, d.driver_name, trip_date, distance_km, fuel_consumed from trips t join drivers d on t.driver_id = d.driver_id

),
first_half_avg as
(
    select driver_id, driver_name, avg(distance_km/fuel_consumed) as first_half_avg from full_data where trip_date <= '2023-06-30' group by driver_id, driver_name
),
second_half_avg as
(
    select driver_id, driver_name, avg(distance_km/fuel_consumed) as second_half_avg from full_data where trip_date > '2023-06-30' group by driver_id, driver_name
)

select f.driver_id, f.driver_name, round(first_half_avg, 2) as first_half_avg, round(second_half_avg, 2) as second_half_avg, round((second_half_avg - first_half_avg), 2) as efficiency_improvement from first_half_avg f join second_half_avg s on 
f.driver_id = s.driver_id where second_half_avg - first_half_avg >0 order by 5 desc, 2 asc

