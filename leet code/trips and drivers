# Write your MySQL query statement below
with cte as
(SELECT driver_id, avg(distance_km/fuel_consumed) first_half_avg
FROM trips
where extract(month from trip_date) >= 1 and extract(month from trip_date) <= 6
GROUP BY driver_id
)

,cte1 as
(SELECT driver_id, avg(distance_km/fuel_consumed) second_half_avg
FROM trips
where extract(month from trip_date) >= 7 and extract(month from trip_date) <= 12
GROUP BY driver_id
)

SELECT P.driver_id,d.driver_name, 
round(p.first_half_avg,2) as first_half_avg, 
round(q.second_half_avg,2) as second_half_avg, 
round(q.second_half_avg - p.first_half_avg,2) as efficiency_improvement
From cte p
inner join cte1 q
on p.driver_id = q.driver_id
inner join drivers d
on p.driver_id = d.driver_id
where q.second_half_avg >  p.first_half_avg
order by efficiency_improvement desc, d.driver_name
